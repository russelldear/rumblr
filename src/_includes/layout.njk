<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or site.title }}</title>
<meta name="description" content="{{ site.description }}">
<link rel="canonical" href="{{ site.source }}">
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: #fafafa;
    color: #1a1a1a;
    -webkit-font-smoothing: antialiased;
  }
  @media (prefers-color-scheme: dark) {
    body { background: #111; color: #e6e6e6; }
    a { color: #9db8ff; }
    .post { border-color: #262626; }
    header, footer { border-color: #262626; }
  }
  .wrap { max-width: 540px; margin: 0 auto; padding: 0 16px; }
  header {
    padding: 28px 0 20px;
    border-bottom: 1px solid #e6e6e6;
    margin-bottom: 8px;
  }
  header h1 { font-size: 1.15rem; margin: 0; letter-spacing: 0.02em; }
  header p { margin: 4px 0 0; font-size: 0.85rem; opacity: 0.6; }
  header h1 a { color: inherit; text-decoration: none; }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .refresh {
    border: 0;
    background: transparent;
    color: inherit;
    opacity: 0.5;
    cursor: pointer;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1;
    padding: 2px 4px;
  }
  .refresh:hover,
  .refresh:focus-visible { opacity: 0.85; }
  .refresh:disabled { opacity: 0.35; cursor: wait; }
  .post {
    padding: 28px 0;
    border-bottom: 1px solid #e6e6e6;
  }
  .post :is(img, video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
    background: #eee;
  }
  .post .media + .media { margin-top: 6px; }
  .post .caption { margin: 14px 0 0; white-space: pre-wrap; }
  .post .caption p { margin: 0 0 0.7em; }
  .post time {
    display: block;
    margin-top: 12px;
    font-size: 0.78rem;
    opacity: 0.5;
  }
  .post time a { color: inherit; text-decoration: none; }
  footer {
    padding: 24px 0 48px;
    font-size: 0.8rem;
    opacity: 0.55;
    text-align: center;
  }
  .empty { padding: 60px 0; text-align: center; opacity: 0.5; }
  .more { padding: 28px 0; text-align: center; font-size: 0.85rem; }
  .more a { color: inherit; opacity: 0.6; }
  .more.loading a { visibility: hidden; }
  .more.loading::after { content: "…"; opacity: 0.5; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="head">
      <h1><a href="{{ '/' | url }}">{{ site.title }}</a></h1>
      {% if page.url == "/" %}
      <button
        class="refresh"
        type="button"
        data-refresh-feed
        data-feed-url="{{ site.refresh.feedUrl }}"
        data-dispatch-url="{{ site.refresh.dispatchUrl }}"
        data-event-type="{{ site.refresh.eventType }}"
        title="Refresh feed in background">
        ↻
      </button>
      {% endif %}
    </div>
    {% if site.description %}<p>{{ site.description }}</p>{% endif %}
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    Mirrored from <a href="{{ site.source }}">the original</a>.
    {% if feedStatus %}
    <br>
    Last poll:
    <time datetime="{{ feedStatus.polledAt }}">{{ feedStatus.polledAt }}</time>
    —
    {% if feedStatus.failedCount == 0 %}
      all feeds OK
    {% else %}
      {{ feedStatus.failedCount }} feed(s) failed
    {% endif %}
    .
    {% endif %}
  </footer>
</div>
<script>
// Progressive "load older posts": fetch the next paginated page, splice its
// posts into the current one. No-JS visitors just follow the link instead.
(function () {
  var main = document.querySelector("main");
  var loading = false;

  function next() { return main.querySelector(".more[data-next]"); }

  async function load(more) {
    if (loading) return;
    loading = true;
    more.classList.add("loading");
    try {
      var res = await fetch(more.dataset.next, { headers: { "X-Requested-With": "fetch" } });
      if (!res.ok) throw new Error(res.status);
      var doc = new DOMParser().parseFromString(await res.text(), "text/html");
      var frag = document.createDocumentFragment();
      doc.querySelectorAll("main > .post").forEach(function (p) { frag.appendChild(p); });
      var following = doc.querySelector("main > .more[data-next]");
      more.replaceWith(frag);
      if (following) { main.appendChild(following); observe(following); }
    } catch (e) {
      more.classList.remove("loading");
    }
    loading = false;
  }

  var io = "IntersectionObserver" in window
    ? new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) load(e.target); });
      }, { rootMargin: "800px 0px" })
    : null;

  function observe(more) {
    if (io) io.observe(more);
    more.querySelector("a").addEventListener("click", function (ev) {
      ev.preventDefault();
      load(more);
    });
  }

  var first = next();
  if (first) observe(first);
})();

(function () {
  var key = "rumblrRefreshToken";
  var button = document.querySelector("[data-refresh-feed]");
  if (!button) return;

  function setState(text, busy) {
    button.textContent = text;
    button.disabled = !!busy;
  }

  button.addEventListener("click", async function () {
    if (button.disabled) return;

    var token = localStorage.getItem(key);
    if (!token) {
      token = prompt("GitHub token (repo scope) for background feed refresh:");
      if (!token) return;
      token = token.trim();
      if (!token) return;
      localStorage.setItem(key, token);
    }

    setState("…", true);

    try {
      var feedRes = await fetch(button.dataset.feedUrl, { cache: "no-store" });
      if (!feedRes.ok) throw new Error("Feed fetch failed (" + feedRes.status + ")");
      await feedRes.text();

      var dispatchRes = await fetch(button.dataset.dispatchUrl, {
        method: "POST",
        headers: {
          accept: "application/vnd.github+json",
          authorization: "Bearer " + token,
          "content-type": "application/json",
          "x-github-api-version": "2022-11-28",
        },
        body: JSON.stringify({
          event_type: button.dataset.eventType,
          client_payload: {
            feed_url: button.dataset.feedUrl,
            requested_at: new Date().toISOString(),
          },
        }),
      });

      if (!dispatchRes.ok) {
        if (dispatchRes.status === 401 || dispatchRes.status === 403) {
          localStorage.removeItem(key);
        }
        throw new Error("Dispatch failed (" + dispatchRes.status + ")");
      }

      button.title = "Refresh queued";
      setState("✓", false);
      setTimeout(function () {
        button.title = "Refresh feed in background";
        setState("↻", false);
      }, 1800);
    } catch (err) {
      console.error(err);
      button.title = "Refresh failed. Check browser console.";
      setState("!", false);
      setTimeout(function () {
        button.title = "Refresh feed in background";
        setState("↻", false);
      }, 2500);
    }
  });
})();
</script>
</body>
</html>
