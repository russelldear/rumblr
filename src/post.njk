---
layout: layout.njk
pagination:
  data: posts
  size: 1
  alias: post
permalink: "/post/{{ post.id }}/index.html"
eleventyComputed:
  title: "{% if post.title %}{{ post.title }}{% else %}{{ post.publishedAt | displayDate }}{% endif %} | {{ site.title }}"
---
<article class="post" id="p{{ post.id }}">
  {% for img in post.images %}
    <div class="media">
      <img src="{{ img.src | url }}"
           {% if img.width %}width="{{ img.width }}"{% endif %}
           {% if img.height %}height="{{ img.height }}"{% endif %}
           alt="{{ img.alt }}" loading="lazy" decoding="async">
    </div>
  {% endfor %}
  {% for vid in post.videos %}
    <div class="media">
      <video src="{{ vid.src | url }}" controls playsinline preload="none"
             {% if vid.poster %}poster="{{ vid.poster | url }}"{% endif %}></video>
    </div>
  {% endfor %}
  {% if post.caption %}
    <div class="caption">{{ post.caption }}</div>
  {% endif %}
  <time datetime="{{ post.publishedAt | isoDate }}">{{ post.publishedAt | displayDate }}</time>
  <p><a href="{{ post.permalink }}">View original Tumblr post</a></p>
</article>
